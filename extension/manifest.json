{
  "manifest_version": 3,
  "name": "jisu Takeover",
  "version": "1.0.0",
  "description": "Hand browser downloads to jisu. Hold Alt to skip.",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "alt.js"
      ],
      "all_frames": true
    }
  ]
}
